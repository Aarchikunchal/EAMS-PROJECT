@Metadata.layer: #CORE


annotate entity zc_repair
with
{

  @UI.facet: [
    {
      id    : 'Repair',
      purpose: #STANDARD,
      type  : #IDENTIFICATION_REFERENCE,
      label : 'Repair Details'
    }
  ]

  @EndUserText.label: 'Activity Number'
  @UI.identification: [ { position: 10, label: 'Activity No' } ]
  @UI.lineItem:       [ { position: 10, label: 'Activity No' } ]
  ActivityNo;

  @EndUserText.label: 'Activity Date'
  @UI.identification: [ { position: 20, label: 'Activity Date' } ]
  @UI.lineItem:       [ { position: 20, label: 'Activity Date' } ]
  ActivityDate;

  @EndUserText.label: 'Activity Performed'
  @UI.identification: [ { position: 30, label: 'Activity Done' } ]
  @UI.lineItem:       [ { position: 30, label: 'Activity Done' } ]
  ActivityDone;

  @EndUserText.label: 'Remark'
  @UI.identification: [ { position: 40, label: 'Remark' } ]
  @UI.lineItem:       [ { position: 40, label: 'Remark' } ]
  Remark;

@UI.hidden: true
  CreatedAt;

@UI.hidden: true
  CreatedBy;

}