managed implementation in class zbp_i_plant_loc unique;
strict ( 2 );

define behavior for ZI_PLANT_LOC //alias <alias_name>
persistent table zeams_plant_loc
lock master
authorization master ( global )
//etag master <field_name>
{
  create ;
  update;
  delete;
  field (readonly : update)Plant;
  field ( mandatory )LocationName,BuildingCode,FloorNumber,Supervisior;
  mapping for zeams_plant_loc corresponding {
  plant = plant;
  location = location;
   LocationName = location_name;
    BuildingCode = building_code;
    FloorNumber = floor_number;
    Supervisior = supervisior;
    Capacity = capacity;
}
}