projection;
strict ( 2 );

define behavior for ZC_SERVICE //alias <alias_name>
{
  use create;
  use update;
  use delete;
 use action OPEN;
 use action INPROGRESS;
 use action COMPLETED;


  use association _item { create; }
}

define behavior for zc_repair //alias <alias_name>
{
  use update;
  use delete;

  use association _header;
}